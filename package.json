{
  "name": "browser-dtm",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal browser DTM: VocaTab vocal + @onjmin/dtm backing (AGPL-inherited)",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build:vocatab": "python3 vendor/vocatab/tools/build.py",
    "dev": "vite --host 127.0.0.1 --port 5300",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5301",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx src/mcp/server.ts",
    "accept:a1": "tsx scripts/accept-a1.ts",
    "accept:render": "tsx scripts/accept-render.ts",
    "accept:fx": "tsx scripts/accept-fx.ts",
    "accept:mcp": "tsx scripts/accept-mcp.ts",
    "accept:all": "npm test && npm run accept:a1 && npm run accept:render && npm run accept:fx && npm run accept:mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@onjmin/dtm": "2.1.38",
    "lamejs": "^1.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "puppeteer-core": "^24.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  }
}
